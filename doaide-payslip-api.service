[Unit]
Description=DoAide PaySlip API
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/doaide-payslip/backend
Environment=PATH=/var/www/doaide-payslip/backend/venv/bin:/usr/bin
ExecStart=/var/www/doaide-payslip/backend/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 3081
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
